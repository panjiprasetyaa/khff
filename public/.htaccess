<IfModule mod_rewrite.c>
  RewriteEngine On

  # Remove trailing slashes (e.g. /program/ -> /program)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # If visiting /program but program/ exists, DO NOT let Apache add a trailing slash
  # and instead internally rewrite to program.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # If the requested URL is a file or directory that exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for 404
  ErrorDocument 404 /404.html
</IfModule>
