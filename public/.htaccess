<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS and non-www (canonical https://khffest.id to prevent origin_mismatch)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://khffest.id/$1 [L,R=301]

  # 2. Ensure directory URLs have a trailing slash so DirectoryIndex loads index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # 3. If file or directory exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. 404 Error page
  ErrorDocument 404 /404.html
</IfModule>
